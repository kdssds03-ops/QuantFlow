# ──────────────────────────────────────────────
# QuantFlow - Environment Variables (TEMPLATE)
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

APP_NAME=QuantFlow
APP_ENV=development
DEBUG=true
SECRET_KEY=
TZ=Asia/Seoul

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=quantflow
POSTGRES_PASSWORD=
POSTGRES_DB=quantflow
DATABASE_URL=postgresql+asyncpg://quantflow:<PASSWORD>@postgres:5432/quantflow

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_NAME=binance
EXCHANGE_SANDBOX=true              # true=테스트넷(페이퍼). 라이브 전 반드시 페이퍼 검증

# ── 전략 사이징 ────────────────────────────────
PREDICTOR_TYPE=TREND              # RULE / ML / TREND(4h 추세추종, 현행)
RISK_FACTOR=0.50                  # 단일심볼 진입 사이징(가용마진 비율)
MAX_DAILY_LOSS_PCT=0.05           # 일일 손실 서킷브레이커
MAX_CAPITAL_PER_SYMBOL_PCT=0.60   # 자본 방화벽(심볼당 진입 상한)
VOL_TARGET_ENABLED=false          # 단일심볼 변동성타게팅(OOS 열위로 OFF)

# ── 멀티심볼 포트폴리오 모드 (분산 + 변동성타게팅) — 기본 OFF ──────────────
# 검증된 4h EMA(30/60)를 여러 코인에 분산 → 단일 BTC 대비 낙폭 대폭 축소
# (메이저4 OOS Sharpe 0.78→1.10). 검증: python scripts/backtest_live.py --portfolio
# ⚠️ 켜기 전 필수 순서:
#   1) 전 심볼 1m 캔들 ≥5일 백필:  python scripts/backfill_symbol_1m.py (심볼별)
#   2) EXCHANGE_SANDBOX=true 로 수주 페이퍼 검증 (로그/일일리포트 확인)
#   3) 통과 시에만 소액 라이브. 라이브 직행 금지.
PORTFOLIO_MODE=false
PORTFOLIO_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT
PORTFOLIO_LEVERAGE_K=1.0          # 위험 손잡이. 권장 1.0 (메이저4는 k>3 시 수익↓·낙폭↑·청산위험↑)
PORTFOLIO_TARGET_VOL=0.15         # 포트 목표 연변동성
PORTFOLIO_MAX_LEV=3.0             # 변동성타겟 레버 상한(내부)
PORTFOLIO_MAX_GROSS=1.5           # 총 노출 하드캡(청산 방지). 권장 ≤1.5

LOG_LEVEL=INFO
